FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /app
RUN groupadd --system --gid 10010 notification && useradd --system --uid 10010 --gid notification --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin notification
COPY requirements-saas-runtime.txt /app/requirements-saas-runtime.txt
RUN python -m pip install --no-cache-dir -r /app/requirements-saas-runtime.txt
COPY --chown=10010:10010 notification_service /app/notification_service
COPY --chown=10010:10010 scripts/manage_notification_migrations.py /app/scripts/manage_notification_migrations.py
USER 10010:10010
EXPOSE 8000
HEALTHCHECK --interval=20s --timeout=4s --start-period=25s --retries=3 CMD python -c "from urllib.request import urlopen; urlopen('http://127.0.0.1:8000/ready',timeout=3).read()"
CMD ["uvicorn","notification_service.api:app","--host","0.0.0.0","--port","8000","--workers","2"]
