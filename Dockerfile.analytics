# Independent Product Analytics API, migration and retention image.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

RUN groupadd --system --gid 10005 analytics \
    && useradd --system --uid 10005 --gid analytics --no-create-home \
       --home-dir /nonexistent --shell /usr/sbin/nologin analytics

COPY requirements-saas-runtime.txt /app/requirements-saas-runtime.txt
RUN python -m pip install --no-cache-dir -r /app/requirements-saas-runtime.txt

COPY --chown=10005:10005 analytics_service /app/analytics_service
COPY --chown=10005:10005 scripts/manage_analytics_migrations.py /app/scripts/manage_analytics_migrations.py
COPY --chown=10005:10005 scripts/migrate_legacy_analytics.py /app/scripts/migrate_legacy_analytics.py

USER 10005:10005
EXPOSE 8000

HEALTHCHECK --interval=20s --timeout=4s --start-period=25s --retries=3 \
  CMD python -c "from urllib.request import urlopen; urlopen('http://127.0.0.1:8000/ready', timeout=3).read()"

CMD ["uvicorn", "analytics_service.api:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
