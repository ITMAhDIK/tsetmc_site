# Dedicated SaaS PostgreSQL database. Never point this at the market-data DB.
# Local Compose maps PostgreSQL to 127.0.0.1:55432.
SAAS_POSTGRES_PASSWORD=replace-with-a-long-random-password
SAAS_DATABASE_URL=postgresql://tloomberg_saas:replace-with-a-long-random-password@127.0.0.1:55432/tloomberg_saas

APP_ENV=development
APP_SECRET_KEY=replace-with-at-least-32-random-bytes
SAAS_COOKIE_SECURE=true

# Required in production; must identify the dedicated SaaS database by name.
SAAS_EXPECTED_DATABASE_NAME=tloomberg_saas
# Production only: explicit host allow-list and HTTPS origins, comma-separated.
SAAS_TRUSTED_HOSTS=
SAAS_ALLOWED_ORIGINS=

# Generate a separate random secret of at least 32 characters for OTP HMAC.
SAAS_OTP_HMAC_SECRET=replace-with-a-distinct-random-secret-of-32-plus-characters
# Generate with Fernet.generate_key(); do not reuse APP_SECRET_KEY or OTP secret.
SAAS_OUTBOX_FERNET_KEY=replace-with-a-valid-fernet-key

SESSION_TTL_HOURS=168
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# Provider credentials belong in a protected secret manager, never in Git.
SNAPPAY_MERCHANT_ID=
SNAPPAY_CLIENT_ID=
SNAPPAY_CLIENT_SECRET=
DIGIPAY_CLIENT_ID=
DIGIPAY_CLIENT_SECRET=
SMS_PROVIDER=
SMS_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SAAS_PAYMENT_CALLBACK_URL=
SAAS_ANALYTICS_RETENTION_DAYS=365
SAAS_ANALYTICS_CONSENT_VERSION=v1

# For local Compose, use:
# docker compose --env-file .env.saas -f docker-compose.saas.yml up -d
# Copy this example to the untracked .env.saas file, replace every placeholder,
# and never commit .env.saas or real credentials.
