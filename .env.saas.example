# Local-only dedicated SaaS PostgreSQL. Never point these URLs at the market-data DB.
# Local Compose maps PostgreSQL to 127.0.0.1:55432.
SAAS_POSTGRES_PASSWORD=replace-with-a-long-random-password
SAAS_DATABASE_URL=postgresql://tloomberg_saas:replace-with-a-long-random-password@127.0.0.1:55432/tloomberg_saas
SAAS_MIGRATION_DATABASE_URL=postgresql://tloomberg_saas:replace-with-a-long-random-password@127.0.0.1:55432/tloomberg_saas
SAAS_EXPECTED_DATABASE_NAME=tloomberg_saas
SAAS_EXPECTED_DB_NAME=tloomberg_saas
SAAS_APP_DATABASE_ROLE=tloomberg_saas

APP_ENV=development
# Local HTTP development only. Production Compose forces this to true.
SAAS_COOKIE_SECURE=false
SAAS_TRUSTED_HOSTS=localhost,127.0.0.1
SAAS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500

# Production deployment only: use an immutable release image digest and real domain.
SAAS_API_IMAGE=ghcr.io/your-org/tloomberg-saas-api@sha256:replace-with-64-character-image-digest
SAAS_EDGE_IMAGE=ghcr.io/your-org/tloomberg-saas-edge@sha256:replace-with-64-character-image-digest
SAAS_DOMAIN=saas.example.com
# The login/admin pages and API share this same HTTPS origin.
# SAAS_TRUSTED_HOSTS=saas.example.com
# SAAS_ALLOWED_ORIGINS=https://saas.example.com

# Generate separate random secrets. Do not reuse passwords between roles.
SAAS_OTP_HMAC_SECRET=replace-with-a-distinct-random-secret-of-32-plus-characters
# Generate with Fernet.generate_key(); do not reuse the DB, HMAC or other secrets.
SAAS_OUTBOX_FERNET_KEY=replace-with-a-valid-fernet-key
# Use another independent Fernet key; MFA secrets must not share the SMS outbox key.
SAAS_ADMIN_MFA_FERNET_KEY=replace-with-a-separate-valid-fernet-key
# Private bearer token for internal Prometheus scraping. Never route /internal/metrics publicly.
SAAS_METRICS_TOKEN=replace-with-a-distinct-random-token-of-32-plus-characters
# Create a mode-0600 file containing the same token for Prometheus credentials_file.
SAAS_METRICS_TOKEN_FILE=/etc/tloomberg-saas/secrets/prometheus_token
# Leave blank until the owner/legal reviewer approves and publishes these documents.
# Account signup remains disabled until both version values are set in the protected environment.
SAAS_TERMS_VERSION=
SAAS_PRIVACY_VERSION=
# Keep the bootstrap superadmin phone in the protected server environment only.
SAAS_SUPERADMIN_PHONE_E164=replace-with-owner-e164-number
SAAS_NOTIFICATION_POLL_SECONDS=2

SAAS_WEB_WORKERS=2
# Total DB connections are approximately workers * SAAS_DB_POOL_MAX per API instance.
SAAS_DB_POOL_MIN=1
SAAS_DB_POOL_MAX=8
SAAS_DB_POOL_TIMEOUT_SECONDS=5
SAAS_LOCAL_BIND_PORT=8000
SAAS_ANALYTICS_RETENTION_DAYS=365
SAAS_ANALYTICS_CONSENT_VERSION=v1
SAAS_PAYMENT_CALLBACK_URL=

# Backup operations only. Keep the private age identity outside Git and host backups.
# SAAS_BACKUP_DATABASE_URL=postgresql://saas_backup@db.example:5432/tloomberg_saas?sslmode=verify-full
# SAAS_BACKUP_DIR=/var/backups/tloomberg-saas
# SAAS_BACKUP_AGE_RECIPIENT=age1replace-with-the-public-recipient
# SAAS_BACKUP_AGE_IDENTITY=/etc/tloomberg-saas/backup-age-identity.txt
# The .pgpass file should be mode 0600; do not put database passwords on command lines.

# Read-only staging probe only; never point this at production.
# SAAS_LOAD_TEST_BASE_URL=https://staging-api.example.com
# SAAS_LOAD_TEST_CONFIRM_HOST=staging-api.example.com
# SAAS_LOAD_TEST_APPROVAL=I_CONFIRM_NON_PRODUCTION_STAGING
# SAAS_LOAD_TEST_DURATION_SECONDS=30
# SAAS_LOAD_TEST_REQUESTS_PER_SECOND=2
# SAAS_LOAD_TEST_CONCURRENCY=4

# Provider credentials belong in a protected secret manager, never in Git.
# The example values above are placeholders; do not commit real values.
SNAPPAY_MERCHANT_ID=
SNAPPAY_CLIENT_ID=
SNAPPAY_CLIENT_SECRET=
DIGIPAY_CLIENT_ID=
DIGIPAY_CLIENT_SECRET=
SMS_PROVIDER=kavenegar
SMS_API_KEY=replace-with-your-kavenegar-api-key
SMS_SENDER=replace-with-your-approved-sender-line
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local database:
# docker compose --env-file .env.saas -f docker-compose.saas.yml up -d
# Apply independent databases:
# python scripts/manage_saas_migrations.py --apply
# python scripts/manage_identity_migrations.py --apply
# python scripts/manage_commerce_migrations.py --apply
# Dry-run legacy SaaS -> Commerce financial history migration:
# python scripts/migrate_saas_commerce.py --dry-run
# Apply only in a rehearsed maintenance window after source backup:
# python scripts/migrate_saas_commerce.py --apply
#
# Local development uses one database role for convenience only. Production
# must use separate SAAS_DATABASE_URL (low-privilege runtime role) and
# SAAS_MIGRATION_DATABASE_URL (migration owner). Create SAAS_APP_DATABASE_ROLE
# out-of-band before production deployment. Production requires HTTPS origins,
# explicit API hosts, secure cookies, and independent OTP/encryption secrets.
# Never commit .env.saas or any real credentials.

# Commerce Service — separate database, runtime credentials and internal service token.
COMMERCE_POSTGRES_PASSWORD=replace-with-another-distinct-long-random-password
COMMERCE_DATABASE_URL=postgresql://tloomberg_commerce:replace-with-another-distinct-long-random-password@127.0.0.1:55434/tloomberg_commerce
COMMERCE_MIGRATION_DATABASE_URL=postgresql://tloomberg_commerce:replace-with-another-distinct-long-random-password@127.0.0.1:55434/tloomberg_commerce
COMMERCE_EXPECTED_DATABASE_NAME=tloomberg_commerce
COMMERCE_APP_DATABASE_ROLE=tloomberg_commerce
COMMERCE_SERVICE_URL=http://127.0.0.1:58002
COMMERCE_SERVICE_TOKEN=replace-with-a-distinct-commerce-service-token-of-32-plus-characters
COMMERCE_TRUSTED_HOSTS=localhost,127.0.0.1
COMMERCE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500
COMMERCE_DB_POOL_MIN=1
COMMERCE_DB_POOL_MAX=8
COMMERCE_DB_POOL_TIMEOUT_SECONDS=5
COMMERCE_WEB_WORKERS=2
COMMERCE_PAYMENT_CALLBACK_URL=
COMMERCE_API_IMAGE=ghcr.io/your-org/tloomberg-commerce@sha256:replace-with-64-character-image-digest

# One-time maintenance-window migration from the legacy SaaS commerce tables.
# This source URL must be a read-only role; the target is the separate Commerce DB.
SAAS_CUTOVER_SOURCE_DATABASE_URL=postgresql://saas_cutover_reader:replace-me@db.example:5432/tloomberg_saas?sslmode=verify-full
SAAS_CUTOVER_SOURCE_DATABASE_NAME=tloomberg_saas

# Identity Service — separate database and secrets; never reuse the SaaS or Market database.
IDENTITY_POSTGRES_PASSWORD=replace-with-a-different-long-random-password
IDENTITY_DATABASE_URL=postgresql://tloomberg_identity:replace-with-a-different-long-random-password@127.0.0.1:55433/tloomberg_identity
IDENTITY_MIGRATION_DATABASE_URL=postgresql://tloomberg_identity:replace-with-a-different-long-random-password@127.0.0.1:55433/tloomberg_identity
IDENTITY_EXPECTED_DATABASE_NAME=tloomberg_identity
IDENTITY_APP_DATABASE_ROLE=tloomberg_identity
IDENTITY_SERVICE_URL=http://127.0.0.1:58001
IDENTITY_SERVICE_TOKEN=replace-with-a-distinct-random-service-token-of-32-plus-characters
IDENTITY_OTP_HMAC_SECRET=replace-with-a-distinct-random-identity-otp-secret
IDENTITY_OUTBOX_FERNET_KEY=replace-with-a-dedicated-valid-fernet-key
IDENTITY_ADMIN_MFA_FERNET_KEY=replace-with-a-different-valid-fernet-key
IDENTITY_COOKIE_SECURE=false
IDENTITY_TRUSTED_HOSTS=localhost,127.0.0.1
IDENTITY_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500
IDENTITY_TERMS_VERSION=
IDENTITY_PRIVACY_VERSION=
IDENTITY_SUPERADMIN_PHONE_E164=replace-with-owner-e164-number
IDENTITY_DB_POOL_MIN=1
IDENTITY_DB_POOL_MAX=8
IDENTITY_DB_POOL_TIMEOUT_SECONDS=5
IDENTITY_API_IMAGE=ghcr.io/your-org/tloomberg-identity@sha256:replace-with-64-character-image-digest
IDENTITY_IMPORT_SOURCE_DATABASE_URL=postgresql://saas_runtime:replace-me@db.example:5432/tloomberg_saas?sslmode=verify-full
IDENTITY_IMPORT_SOURCE_DATABASE_NAME=tloomberg_saas

# Temporary cutover-only write credential; never use this for the read-only importer.
IDENTITY_CUTOVER_SOURCE_DATABASE_URL=postgresql://cutover_operator:replace-me@db.example:5432/tloomberg_saas?sslmode=verify-full
IDENTITY_IMPORT_SOURCE_MFA_FERNET_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=


# Product Analytics Service — isolated local database and independent API.
ANALYTICS_POSTGRES_PASSWORD=replace-with-a-distinct-long-random-password
ANALYTICS_DATABASE_URL=postgresql://tloomberg_analytics:replace-with-a-distinct-long-random-password@127.0.0.1:55435/tloomberg_analytics
ANALYTICS_MIGRATION_DATABASE_URL=postgresql://tloomberg_analytics:replace-with-a-distinct-long-random-password@127.0.0.1:55435/tloomberg_analytics
ANALYTICS_EXPECTED_DATABASE_NAME=tloomberg_analytics
ANALYTICS_EXPECTED_DB_NAME=tloomberg_analytics
ANALYTICS_APP_DATABASE_ROLE=tloomberg_analytics
ANALYTICS_TRUSTED_HOSTS=localhost,127.0.0.1
ANALYTICS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500
ANALYTICS_EVENTS_PER_MINUTE=600
ANALYTICS_DB_POOL_MIN=1
ANALYTICS_DB_POOL_MAX=8
ANALYTICS_DB_POOL_TIMEOUT_SECONDS=5
ANALYTICS_WEB_WORKERS=2
SAAS_ANALYTICS_CONSENT_VERSION=v1
ANALYTICS_RETENTION_POLL_SECONDS=3600
ANALYTICS_API_IMAGE=ghcr.io/your-org/tloomberg-analytics@sha256:replace-with-64-character-image-digest

# One-time, read-only legacy import. Configure only during a controlled migration.
ANALYTICS_IMPORT_SOURCE_DATABASE_URL=postgresql://saas_cutover_reader:replace-me@db.example:5432/tloomberg_saas?sslmode=verify-full
ANALYTICS_IMPORT_SOURCE_DATABASE_NAME=tloomberg_saas
ANALYTICS_IMPORT_TARGET_DATABASE_URL=

# Production-only encrypted backup settings; keep the private age identity outside Git.
# ANALYTICS_BACKUP_DATABASE_URL=postgresql://analytics_backup@db.example:5432/tloomberg_analytics?sslmode=verify-full
# ANALYTICS_BACKUP_DIR=/var/backups/tloomberg/analytics
# ANALYTICS_BACKUP_AGE_RECIPIENT=age1replace-with-production-recipient
# ANALYTICS_BACKUP_AGE_IDENTITY=/etc/tloomberg-analytics/secrets/backup-age-identity.txt
# ANALYTICS_BACKUP_REMOTE=immutable-remote:tloomberg/analytics

# Independent CRM Service — separate database and private projection credentials.
CRM_POSTGRES_PASSWORD=replace-with-a-distinct-long-random-password
CRM_DATABASE_URL=postgresql://tloomberg_crm:replace-with-a-distinct-long-random-password@127.0.0.1:55436/tloomberg_crm
CRM_MIGRATION_DATABASE_URL=postgresql://tloomberg_crm:replace-with-a-distinct-long-random-password@127.0.0.1:55436/tloomberg_crm
CRM_EXPECTED_DATABASE_NAME=tloomberg_crm
CRM_APP_DATABASE_ROLE=tloomberg_crm
CRM_PROJECTION_TOKEN=replace-with-a-distinct-random-projection-token-of-32-plus-characters
CRM_DB_POOL_MIN=1
CRM_DB_POOL_MAX=8
CRM_DB_POOL_TIMEOUT_SECONDS=5
CRM_WEB_WORKERS=2
CRM_API_IMAGE=ghcr.io/your-org/tloomberg-crm@sha256:replace-with-64-character-image-digest
# One-time import: source must be a read-only SaaS database role.
CRM_IMPORT_SOURCE_DATABASE_URL=postgresql://saas_cutover_reader:replace-me@db.example:5432/tloomberg_saas?sslmode=verify-full
CRM_IMPORT_SOURCE_DATABASE_NAME=tloomberg_saas
CRM_MIGRATION_DATABASE_NAME=tloomberg_crm

# Independent Notification Service — isolated database, API and delivery worker.
NOTIFICATION_POSTGRES_PASSWORD=replace-with-a-distinct-long-random-password
NOTIFICATION_DATABASE_URL=postgresql://tloomberg_notifications:replace-with-a-distinct-long-random-password@127.0.0.1:55437/tloomberg_notifications
NOTIFICATION_MIGRATION_DATABASE_URL=postgresql://tloomberg_notifications:replace-with-a-distinct-long-random-password@127.0.0.1:55437/tloomberg_notifications
NOTIFICATION_EXPECTED_DATABASE_NAME=tloomberg_notifications
NOTIFICATION_APP_DATABASE_ROLE=tloomberg_notifications
NOTIFICATION_INGEST_TOKEN=replace-with-a-distinct-random-ingest-token-of-32-plus-characters
NOTIFICATION_TRUSTED_HOSTS=localhost,127.0.0.1
NOTIFICATION_DB_POOL_MIN=1
NOTIFICATION_DB_POOL_MAX=8
NOTIFICATION_DB_POOL_TIMEOUT_SECONDS=5
NOTIFICATION_WEB_WORKERS=2
NOTIFICATION_WORKER_BATCH_SIZE=20
NOTIFICATION_WORKER_IDLE_SECONDS=2
NOTIFICATION_API_IMAGE=ghcr.io/your-org/tloomberg-notifications@sha256:replace-with-64-character-image-digest
# Email provider: SMTP with mandatory STARTTLS; keep credentials in protected secrets.
NOTIFICATION_SMTP_HOST=
NOTIFICATION_SMTP_PORT=587
NOTIFICATION_SMTP_USER=
NOTIFICATION_SMTP_PASSWORD=
NOTIFICATION_EMAIL_FROM=
# SMS provider: HTTPS webhook adapter; supply provider URL and bearer token.
NOTIFICATION_SMS_WEBHOOK_URL=
NOTIFICATION_SMS_WEBHOOK_TOKEN=

NOTIFICATION_IDENTITY_SERVICE_TOKEN=replace-with-a-distinct-scoped-identity-contact-token-of-32-plus-characters
