# Dedicated PostgreSQL database. Never point this at market-data DB.
SAAS_DATABASE_URL=postgresql://tloomberg_saas:change-me@127.0.0.1:5432/tloomberg_saas
APP_ENV=development
APP_SECRET_KEY=replace-with-at-least-32-random-bytes
SESSION_TTL_HOURS=168
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
# Provider credentials belong in an untracked .env or secret manager.
SNAPPAY_MERCHANT_ID=
SNAPPAY_CLIENT_ID=
SNAPPAY_CLIENT_SECRET=
DIGIPAY_CLIENT_ID=
DIGIPAY_CLIENT_SECRET=
SMS_PROVIDER=
SMS_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ANALYTICS_RETENTION_DAYS=180
