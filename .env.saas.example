# Local-only dedicated SaaS PostgreSQL. Never point these URLs at the market-data DB.
# Local Compose maps PostgreSQL to 127.0.0.1:55432.
SAAS_POSTGRES_PASSWORD=replace-with-a-long-random-password
SAAS_DATABASE_URL=postgresql://tloomberg_saas:replace-with-a-long-random-password@127.0.0.1:55432/tloomberg_saas
SAAS_MIGRATION_DATABASE_URL=postgresql://tloomberg_saas:replace-with-a-long-random-password@127.0.0.1:55432/tloomberg_saas
SAAS_EXPECTED_DATABASE_NAME=tloomberg_saas
SAAS_APP_DATABASE_ROLE=tloomberg_saas

APP_ENV=development
SAAS_COOKIE_SECURE=true
# Production-only explicit host and HTTPS origin allow-lists, comma-separated.
SAAS_TRUSTED_HOSTS=
SAAS_ALLOWED_ORIGINS=

# Generate separate random secrets. Do not reuse passwords between roles.
SAAS_OTP_HMAC_SECRET=replace-with-a-distinct-random-secret-of-32-plus-characters
# Generate with Fernet.generate_key(); do not reuse the DB, HMAC or other secrets.
SAAS_OUTBOX_FERNET_KEY=replace-with-a-valid-fernet-key

SAAS_WEB_WORKERS=2
# Total DB connections are roughly workers * SAAS_DB_POOL_MAX per API instance.
SAAS_DB_POOL_MIN=1
SAAS_DB_POOL_MAX=8
SAAS_DB_POOL_TIMEOUT_SECONDS=5
SAAS_LOCAL_BIND_PORT=8000
SAAS_ANALYTICS_RETENTION_DAYS=365
SAAS_ANALYTICS_CONSENT_VERSION=v1
SAAS_PAYMENT_CALLBACK_URL=

# Provider credentials belong in a protected secret manager, never in Git.
SNAPPAY_MERCHANT_ID=
SNAPPAY_CLIENT_ID=
SNAPPAY_CLIENT_SECRET=
DIGIPAY_CLIENT_ID=
DIGIPAY_CLIENT_SECRET=
SMS_PROVIDER=
SMS_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local database:
# docker compose --env-file .env.saas -f docker-compose.saas.yml up -d
# Apply migrations: set SAAS_MIGRATION_DATABASE_URL and
# SAAS_EXPECTED_DATABASE_NAME, then run:
# python scripts/manage_saas_migrations.py --apply
#
# Production uses a separate low-privilege SAAS_DATABASE_URL and a dedicated
# migration-owner SAAS_MIGRATION_DATABASE_URL. Create SAAS_APP_DATABASE_ROLE
# out-of-band before running the production compose stack. Production also
# requires APP_ENV=production, HTTPS origins, trusted hosts, secure cookies,
# and both independent OTP/encryption secrets. Never commit .env.saas.
