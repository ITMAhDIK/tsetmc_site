# Dedicated Identity Service image. It includes shared pure security primitives only.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /app
RUN groupadd --system --gid 10002 identity && useradd --system --uid 10002 --gid identity --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin identity
COPY requirements-saas-runtime.txt /app/requirements-saas-runtime.txt
RUN python -m pip install --no-cache-dir -r /app/requirements-saas-runtime.txt
COPY --chown=10002:10002 saas_core /app/saas_core
COPY --chown=10002:10002 identity_service /app/identity_service
COPY --chown=10002:10002 scripts/manage_identity_migrations.py /app/scripts/manage_identity_migrations.py
COPY --chown=10002:10002 scripts/migrate_saas_identity.py /app/scripts/migrate_saas_identity.py
COPY --chown=10002:10002 scripts/finalize_saas_identity_cutover.py /app/scripts/finalize_saas_identity_cutover.py
COPY --chown=10002:10002 scripts/identity_sms_worker.py /app/scripts/identity_sms_worker.py
USER 10002:10002
EXPOSE 8000
HEALTHCHECK --interval=20s --timeout=4s --start-period=20s --retries=3 CMD python -c "from urllib.request import urlopen; urlopen('http://127.0.0.1:8000/ready',timeout=3).read()"
CMD ["uvicorn","identity_service.api:app","--host","0.0.0.0","--port","8000","--workers","2"]
