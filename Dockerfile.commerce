# Independently deployable Commerce API image.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

RUN groupadd --system --gid 10003 commerce \
    && useradd --system --uid 10003 --gid commerce --no-create-home \
       --home-dir /nonexistent --shell /usr/sbin/nologin commerce

COPY requirements-saas-runtime.txt /app/requirements-saas-runtime.txt
RUN python -m pip install --no-cache-dir -r /app/requirements-saas-runtime.txt

COPY --chown=10003:10003 commerce_service /app/commerce_service
COPY --chown=10003:10003 scripts/manage_commerce_migrations.py /app/scripts/manage_commerce_migrations.py

USER 10003:10003

EXPOSE 8000

HEALTHCHECK --interval=20s --timeout=4s --start-period=25s --retries=3 \
  CMD python -c "from urllib.request import urlopen; urlopen('http://127.0.0.1:8000/ready', timeout=3).read()"

CMD ["uvicorn", "commerce_service.api:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
