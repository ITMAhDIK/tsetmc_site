{$SAAS_DOMAIN} {
    encode zstd gzip

    request_body {
        max_size 1MB
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }

    # Serve the browser and the API from one HTTPS origin. This preserves
    # first-party HttpOnly cookies and avoids dependence on third-party cookies.
    root * /srv/saas

    # The app uses /api/v1 in the browser; FastAPI owns the unprefixed routes.
    handle_path /api/v1/* {
        reverse_proxy saas-api:8000
    }

    # Never expose private metrics or FastAPI internals via the static site.
    @private path /internal/* /openapi.json /docs /redoc
    respond @private 404

    try_files {path} {path}/ /index.html
    file_server
}
