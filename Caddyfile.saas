{$SAAS_DOMAIN} {
    encode zstd gzip

    request_body {
        max_size 1MB
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }

    # Serve the browser and the API from one HTTPS origin. This preserves
    # first-party HttpOnly cookies and avoids dependence on third-party cookies.
    root * /srv/saas

    # Never expose internal service endpoints, even through the /api/v1 prefix.
    @private path /api/v1/internal/* /internal/* /openapi.json /docs /redoc
    handle @private {
        respond 404
    }

    # Identity is a separate upstream and owns all browser authentication routes.
    # Strip only the /api/v1 prefix so Identity receives /auth/* unchanged.
    @identity path /api/v1/auth /api/v1/auth/*
    handle @identity {
        uri strip_prefix /api/v1
        reverse_proxy identity-api:8000
    }

    # All other APIs remain in the SaaS application.
    handle_path /api/v1/* {
        reverse_proxy saas-api:8000
    }

    # Private API paths are denied above; only named public API prefixes are proxied.

    try_files {path} {path}/ /index.html
    file_server
}
