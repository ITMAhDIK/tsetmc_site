{$SAAS_DOMAIN} {
    encode zstd gzip

    request_body {
        max_size 1MB
    }

    # /ready returns only a generic readiness state; it exposes no database
    # name, schema details, secrets or customer data and is used by probes.
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }

    # The static site is hosted separately (e.g. GitHub Pages). Only the
    # versioned API prefix is proxied; Caddy strips /api/v1 before FastAPI.
    handle_path /api/v1/* {
        reverse_proxy saas-api:8000
    }

    respond "Tloomberg SaaS API gateway" 404
}
