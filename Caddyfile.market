{$MARKET_API_DOMAIN} {
    encode zstd gzip

    request_body {
        max_size 1MB
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }

    # Instrument reference/search and daily prices are served by the
    # independent read-only Market Data microservice.
    @marketData path /api/v1/market/instruments /api/v1/market/instruments/* /api/v1/stocks/search /api/v1/stocks/*/prices
    handle @marketData {
        reverse_proxy market-data-api:8000
    }

    # Ownership, portfolio, screener and legacy routes remain on Market API.
    handle /api/v1/* {
        reverse_proxy market-api:8000
    }

    handle /healthz {
        reverse_proxy market-api:8000
    }

    handle /readyz {
        reverse_proxy market-api:8000
    }

    respond "Tloomberg Market API" 404
}
